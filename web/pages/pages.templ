package pages

import (
 "fmt"
 "strconv"
 "github.com/shopspring/decimal"
 "github.com/google/uuid"
 documents "panlyackerp/internal/modules/documents/domain"
 inventory "panlyackerp/internal/modules/inventory/application"
 accounting "panlyackerp/internal/modules/accounting/ports"
 cash "panlyackerp/internal/modules/cash/ports"
 reporting "panlyackerp/internal/modules/reporting/ports"
)

func Money(s string) string { d,err:=decimal.NewFromString(s);if err!=nil{return s};return d.StringFixed(2) }
func SettlementAmount(s string) string {
 d, err := decimal.NewFromString(s)
 if err != nil { return s }
 if d.Equal(d.Round(2)) { return d.StringFixed(2) }
 return d.StringFixed(4)
}
func SettlementBalanceLabel(direction string) string {
 if direction == "SALE" { return "Restant à encaisser" }
 return "Restant à payer"
}
func Status(s string) string { switch s {case "POSTED":return "Comptabilisée";case "CONFIRMED":return "Confirmée";default:return "À vérifier"} }
func InvoiceURL(id string) string { return "/app/invoices/"+id }

templ Login(csrf,message string) {
<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Connexion · PanlyackERP</title><link rel="icon" type="image/png" href="/static/panlyack-logo.png"/><link rel="stylesheet" href="/static/app.css"/></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-form-side"><div class="auth-form-inner"><div class="auth-brand"><span class="brand-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></span><span>PanlyackERP</span></div><h1>Retrouvez vos opérations.</h1><p class="muted">Connectez-vous à l’espace de travail de votre entreprise.</p>
if message!="" {
<div class="notice error" role="alert">{ message }</div>
}
<form method="post" action="/login"><input type="hidden" name="csrf" value={ csrf }/><label for="email">Adresse e-mail</label><input id="email" name="email" type="email" autocomplete="username" required maxlength="254"/><label for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="current-password" required minlength="12" maxlength="128"/><button type="submit">Se connecter</button></form><p class="auth-help">Vous découvrez PanlyackERP ? <a href="/register">Créer un compte de test</a></p></div></section>
<aside class="auth-story"><img class="auth-story-photo" src="/static/auth-handoff.webp" alt=""/><div class="auth-story-inner"><div class="auth-story-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></div><h2>Du document aux comptes, sans perdre le fil.</h2><p>Importez une facture, vérifiez les données, puis consultez ses effets sur le stock, le journal et la trésorerie.</p><div class="auth-steps"><span>Importer</span><span>Vérifier</span><span>Comptabiliser</span></div><span class="auth-footnote">PanlyackERP · Espace de démonstration local</span></div></aside></main></body></html>
}

templ Register(csrf,message string) {
<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Créer un compte · PanlyackERP</title><link rel="icon" type="image/png" href="/static/panlyack-logo.png"/><link rel="stylesheet" href="/static/app.css"/></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-form-side"><div class="auth-form-inner"><div class="auth-brand"><span class="brand-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></span><span>PanlyackERP</span></div><h1>Créez votre espace de test.</h1><p class="muted">Votre entreprise dispose de ses propres factures, stocks, comptes et soldes de démonstration.</p>
if message!="" {
<div class="notice error" role="alert">{ message }</div>
}
<form method="post" action="/register"><input type="hidden" name="csrf" value={ csrf }/><label for="organization_name">Nom de votre entreprise</label><input id="organization_name" name="organization_name" autocomplete="organization" required minlength="2" maxlength="80"/><label for="email">Adresse e-mail</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"/><label for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/><p class="auth-field-help">12 caractères minimum.</p><label for="password_confirm">Confirmer le mot de passe</label><input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/><button type="submit">Créer mon espace</button></form><p class="auth-help">Vous avez déjà un compte ? <a href="/login">Se connecter</a></p></div></section>
<aside class="auth-story"><img class="auth-story-photo" src="/static/auth-handoff.webp" alt=""/><div class="auth-story-inner"><div class="auth-story-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></div><h2>Essayez le parcours complet.</h2><p>Importez une facture, confirmez ses données, puis voyez les effets sur le stock, la comptabilité et la trésorerie.</p><div class="auth-steps"><span>Importer</span><span>Vérifier</span><span>Comptabiliser</span></div><span class="auth-footnote">PanlyackERP · Espace de démonstration local</span></div></aside></main></body></html>
}

templ Logout(csrf string) {
<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Déconnexion · PanlyackERP</title><link rel="icon" type="image/png" href="/static/panlyack-logo.png"/><link rel="stylesheet" href="/static/app.css"/></head><body class="auth-page"><main class="logout-card"><h1>Quitter l’espace de travail ?</h1><p class="muted">Votre session sera fermée sur ce navigateur.</p><form method="post" action="/logout"><input type="hidden" name="csrf" value={ csrf }/><button type="submit">Se déconnecter</button><a class="secondary button" href="/app/dashboard">Retour au tableau de bord</a></form></main></body></html>
}

templ Layout(title,active,orgName string) {
 <!DOCTYPE html>
 <html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{ title } · PanlyackERP</title><link rel="icon" type="image/png" href="/static/panlyack-logo.png"/><link rel="stylesheet" href="/static/app.css"/><script src="/static/htmx.min.js" defer></script><meta name="htmx-config" content="{&quot;allowEval&quot;:false,&quot;allowScriptTags&quot;:false}"/></head>
 <body><a class="skip" href="#main">Aller au contenu</a><div class="shell"><input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="Afficher le menu de navigation"/><label class="nav-scrim" for="nav-toggle" aria-hidden="true"></label>
 <aside class="sidebar"><div class="sidebar-top"><a class="brand" href="/app/dashboard"><span class="brand-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></span><span>Panlyack<span class="brand-light">ERP</span></span></a><label class="menu-trigger" for="nav-toggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Menu</span></label></div><nav aria-label="Navigation principale"><div class="drawer-heading"><span>Navigation</span><label class="nav-close" for="nav-toggle" aria-label="Fermer le menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg></label></div><p class="nav-label">Espace de travail</p>
 for _,item:=range []struct{Path,Label string}{{"dashboard","Vue d’ensemble"},{"invoices","Factures"},{"inventory","Stock"},{"accounting","Comptabilité"},{"cash","Trésorerie"}} {
  <a href={ templ.SafeURL("/app/"+item.Path) } aria-current={ activePage(active,item.Path) }><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={ templ.SafeURL("/static/nav-icons.svg#"+item.Path) }></use></svg><span>{ item.Label }</span></a>
 }
 </nav><div class="workspace"><span class="workspace-avatar brand-mark" aria-hidden="true"><img src="/static/panlyack-logo.png" alt="" width="1254" height="1254"/></span><span class="workspace-copy"><span class="workspace-name">{ orgName }</span><span>Édition locale · démonstration</span></span></div></aside>
 <div class="main-column"><header class="topbar"><span class="organization-name">{ title }</span><span class="topbar-right"><span class="org-meta">{ orgName } <span aria-hidden="true">·</span> USD</span><a class="logout-link" href="/logout">Déconnexion</a></span></header><main id="main" class="content">{ children... }</main></div>
 </div></body></html>
}

templ Heading(title,description string) {
<div class="page-heading"><div><h1>{ title }</h1><p class="muted">{ description }</p></div>{ children... }</div>
}

templ KPI(s reporting.Summary) {
 <dl class="metrics" id="kpis" hx-get="/app/_partials/dashboard/kpis" hx-trigger="every 30s" hx-swap="outerHTML">
 for _,m:=range []struct{Label,Value,Icon,Color string}{{"Chiffre d’affaires",s.Revenue,"accounting","blue"},{"Factures comptabilisées",strconv.Itoa(s.Count),"invoices","purple"},{"Valeur du stock",s.Inventory,"inventory","amber"},{"Trésorerie disponible",s.Cash,"cash","green"}} {
 <div class="metric"><div class={ "metric-icon "+m.Color }><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={ templ.SafeURL("/static/nav-icons.svg#"+m.Icon) }></use></svg></div><dt>{ m.Label }</dt><dd>
 if m.Icon=="invoices" {
 { m.Value }
 } else {
 { Money(m.Value) } <small>USD</small>
 }
 </dd></div>
 }
 </dl>
}

templ Dashboard(s reporting.Summary,invoices []documents.Invoice,orgName string) {
 @Layout("Vue d’ensemble","dashboard",orgName) {
 <div class="dashboard-heading"><div><h1>Vue d’ensemble</h1><p>Vos documents et leurs effets sur l’activité, en un coup d’œil.</p></div><a class="button dashboard-primary" href="/app/invoices/new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Importer une facture</a></div>
 <nav class="dashboard-actions" aria-label="Accès rapides"><a href="/app/invoices">Toutes les factures</a><a href="/app/inventory">Consulter le stock</a><a href="/app/accounting">Journal comptable</a><a href="/app/cash">Trésorerie</a></nav>
 @KPI(s)
 <div class="dashboard-overview"><section class="panel activity-panel"><div class="panel-body"><div class="dashboard-section-heading"><div><h2>Situation de l’activité</h2><p>Soldes issus des factures comptabilisées</p></div><a href="/app/accounting">Voir le journal</a></div><dl class="activity-list"><div><dt>Achats</dt><dd>{ Money(s.Purchases) } USD</dd></div><div><dt>Créances clients</dt><dd>{ Money(s.Receivables) } USD</dd></div><div><dt>Coût des ventes</dt><dd>{ Money(s.Cost) } USD</dd></div><div><dt>Dettes fournisseurs</dt><dd>{ Money(s.Payables) } USD</dd></div></dl></div></section>
 <section class="dashboard-workflow"><img src="/static/dashboard-growth.jpg" alt=""/><div class="dashboard-workflow-content"><h2>Chaque opération part d’un document.</h2><p>Importez, vérifiez puis comptabilisez. Les soldes se mettent à jour après validation.</p><a href="/app/invoices/new">Commencer avec une facture <span aria-hidden="true">→</span></a></div></section></div>
 <section class="dashboard-recent"><div class="dashboard-section-heading"><div><h2>Factures récentes</h2><p>Ouvrez un document pour consulter son état et ses lignes.</p></div><a href="/app/invoices">Voir toutes les factures</a></div>@InvoiceTable(invoices)</section>
 }
}

templ InvoiceTable(invoices []documents.Invoice) {
 <div class="panel">
 if len(invoices)==0 {
<div class="empty"><h2>Votre première facture commence ici</h2><p class="muted">Importez un document, vérifiez les lignes et validez ses effets sur votre activité.</p><a href="/app/invoices/new">Importer un document</a></div>
} else {

 <div class="table-scroll"><table><caption>Factures récentes</caption><thead><tr><th>Référence</th><th>Partenaire</th><th>Date</th><th>Statut</th><th class="amount">Montant</th></tr></thead><tbody>
 for _,i:=range invoices {
<tr><td><a href={ templ.SafeURL(InvoiceURL(i.ID)) }>{ i.Number }</a></td><td>{ i.Partner }</td><td>{ i.IssueDate }</td><td><span class={ statusClass(i.Status) }>{ Status(i.Status) }</span></td><td class="amount">{ Money(i.Total) } { i.Currency }</td></tr>
}
 </tbody></table></div>
 }
 </div>
}

templ Invoices(invoices []documents.Invoice,orgName string) {
@Layout("Factures","invoices",orgName) {
@Heading("Factures","Chaque opération conserve son document d’origine.") {
<a class="button" href="/app/invoices/new">Importer une facture</a>
} @InvoiceTable(invoices)
}
}

templ Upload(csrf,message,orgName string) {
 @Layout("Importer une facture","invoices",orgName) {
@Heading("Importer une facture","Ajoutez une photo nette ou un PDF. Vous vérifierez les données avant toute opération.") {
}
 <div class="upload-layout"><div class="panel upload-panel"><div class="panel-body">
 if message!="" {
<div class="notice error" role="alert">{ message }</div>
}
 <form method="post" action="/app/invoices/upload" enctype="multipart/form-data" hx-post="/app/invoices/upload" hx-encoding="multipart/form-data" hx-target="body" hx-disabled-elt="find button">
 <input type="hidden" name="csrf" value={ csrf }/><label for="document">Document de la facture</label><input id="document" type="file" name="document" accept="image/png,image/jpeg,application/pdf" required/><p class="muted">PNG, JPEG ou PDF · 10 Mo maximum. En mode vision : PDF de 1 à 5 pages.</p>
 <div class="actions"><button type="submit">Extraire les données</button><span class="htmx-indicator" role="status">Analyse en cours…</span></div>
 </form></div></div><aside class="upload-visual"><img src="/static/extraction-review.jpg" alt=""/><div><h2>L’analyse ouvre le travail.</h2><p>Relisez les données extraites et confirmez chaque facture avant sa comptabilisation.</p></div></aside></div>
}
}

templ Review(i documents.Invoice,csrf,message,orgName string, settlements []cash.Settlement, due string) {
 @Layout("Vérifier la facture","invoices",orgName) {
 @Heading(i.Number,"Vérifiez le document et les données avant de comptabiliser.") {
<span class={ statusClass(i.Status) }>{ Status(i.Status) }</span>
}
 if message!="" {
<div class="notice error" role="alert">{ message }</div>
}
 if i.ExtractionMode=="demo" {
<div class="notice">Mode démonstration : les données ci-dessous sont simulées. Elles ne sont pas extraites de votre fichier.</div>
}
 if i.ExtractionMode!="demo" {
 for _, warning := range i.Warnings {
<div class="notice">{ warning }</div>
}
}
 if i.Status=="POSTED" {
<div class="notice" role="status">Facture comptabilisée. Stock, journal, trésorerie et tableau de bord ont été mis à jour. Ce document est désormais en lecture seule.</div>
}
 <div class="review-grid"><section class="panel document-panel"><div class="panel-body"><h2>Document d’origine</h2><a href={ templ.SafeURL(InvoiceURL(i.ID)+"/document") } target="_blank" rel="noopener">Ouvrir le document</a>
 if i.ExtractionMode!="demo" {
<p class="muted">Confiance indiquée : { i.Confidence }</p>
}
 </div><iframe class="preview" title="Document d’origine" src={ templ.SafeURL(InvoiceURL(i.ID)+"/document") }></iframe></section>
 <section class="panel review-panel"><div class="panel-body"><h2>Données de la facture</h2>
 <form method="post" action={ templ.SafeURL(InvoiceURL(i.ID)+"/review") }>
 <input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="version" value={ strconv.Itoa(i.Version) }/>
 <fieldset disabled?={ i.Status!="NEEDS_REVIEW" }><h3 class="section-title">Informations générales</h3><div class="form-grid">
 <div><label for="number">Référence</label><input id="number" name="number" value={ i.Number } required maxlength="100"/></div>
 <div><label for="partner">Fournisseur / client</label><input id="partner" name="partner" value={ i.Partner } required maxlength="200"/></div>
 <div><label for="date">Date</label><input id="date" name="issue_date" type="date" value={ i.IssueDate } required/></div>
 <div><label for="direction">Opération</label><select id="direction" name="direction"><option value="PURCHASE" selected?={ i.Direction=="PURCHASE" }>Achat</option><option value="SALE" selected?={ i.Direction=="SALE" }>Vente</option></select></div>
 <div><label for="currency">Devise</label><select id="currency" name="currency"><option value="USD">USD</option></select></div>
 <div><label for="total">Total, taxes incluses</label><input id="total" name="total" inputmode="decimal" value={ i.Total } required/></div>
 </div><div class="section-heading"><h3 class="section-title">Lignes de facture</h3><p class="muted">Les SKU identiques désignent le même produit. Un nouveau SKU crée un produit à la comptabilisation d’un achat.</p></div>
 <div class="table-scroll"><table class="line-table"><thead><tr><th>SKU</th><th>Produit</th><th>Unité</th><th>Quantité</th><th>Prix unitaire</th><th>Taxe %</th><th>Action</th></tr></thead><tbody>
 for n,l:=range i.Lines {
<tr>
 <td><input aria-label={ fmt.Sprintf("SKU ligne %d",n+1) } name="sku" value={ l.SKU }/></td>
 <td><input class="name" aria-label={ fmt.Sprintf("Produit ligne %d",n+1) } name="name" value={ l.Name } required/></td>
 <td><input aria-label={ fmt.Sprintf("Unité ligne %d",n+1) } name="unit" value={ l.Unit } required/></td>
 <td><input aria-label={ fmt.Sprintf("Quantité ligne %d",n+1) } name="quantity" value={ l.Quantity } inputmode="decimal" required/></td>
 <td><input aria-label={ fmt.Sprintf("Prix ligne %d",n+1) } name="unit_price" value={ l.UnitPrice } inputmode="decimal" required/></td>
 <td><input aria-label={ fmt.Sprintf("Taxe ligne %d",n+1) } name="tax_rate" value={ l.TaxRate } inputmode="decimal" required/></td>
<td><button class="secondary" name="remove_line" value={ strconv.Itoa(n) } formnovalidate aria-label={ fmt.Sprintf("Supprimer la ligne %d",n+1) }>Retirer</button></td>
 </tr>
}
 </tbody></table></div>
 if i.Status=="NEEDS_REVIEW" && len(i.Lines)<100 {
<button class="secondary" name="action" value="add_line" formnovalidate>Ajouter une ligne</button>
}
 <div class="section-heading"><h3 class="section-title">Règlement</h3><p class="muted">Le solde non réglé devient une dette fournisseur ou une créance client.</p></div><div class="form-grid">
 for _,method:=range []string{"CASH","BANK","MOBILE_MONEY","CARD"} {
<div><label for={ method }>{ paymentLabel(method) }</label><input id={ method } name={ "payment_"+method } value={ paymentAmount(i,method) } inputmode="decimal"/></div>
}
 </div>
 if i.Status=="NEEDS_REVIEW" {
<div class="actions"><button name="action" value="confirm">Confirmer les données</button><button class="secondary" name="action" value="save">Enregistrer</button></div>
}
 </fieldset></form>
 if i.Status=="CONFIRMED" {
<div class="actions"><form method="post" action={ templ.SafeURL(InvoiceURL(i.ID)+"/post") }><input type="hidden" name="csrf" value={ csrf }/><button>Comptabiliser la facture</button></form><form method="post" action={ templ.SafeURL(InvoiceURL(i.ID)+"/reopen") }><input type="hidden" name="csrf" value={ csrf }/><button class="secondary">Reprendre la vérification</button></form></div>
}
 if i.Status=="POSTED" {
<div class="actions"><a href="/app/accounting">Voir le journal</a><a href="/app/dashboard">Voir les soldes</a></div>
 <div class="section-heading"><h3 class="section-title">Solde de la facture</h3><p>{ SettlementBalanceLabel(i.Direction) } : <strong>{ SettlementAmount(due) } USD</strong></p></div>
if len(settlements)>0 {
<div class="table-scroll"><table><thead><tr><th>Date</th><th>Moyen</th><th class="amount">Montant USD</th></tr></thead><tbody>
for _,payment:=range settlements {
<tr><td>{ payment.Date }</td><td>{ paymentLabel(payment.Method) }</td><td class="amount">{ SettlementAmount(payment.Amount) }</td></tr>
}</tbody></table></div>
}
if due!="0" {
<form class="settlement-form" method="post" action={ templ.SafeURL(InvoiceURL(i.ID)+"/settlements") } hx-post={ InvoiceURL(i.ID)+"/settlements" } hx-target="body" hx-disabled-elt="find button"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="request_id" value={ uuid.NewString() }/>
<div class="form-grid"><div><label for="settlement_amount">Montant</label><input id="settlement_amount" name="amount" inputmode="decimal" value={ due } required/></div><div><label for="settlement_method">Moyen de paiement</label><select id="settlement_method" name="method"><option value="CASH">Espèces</option><option value="BANK">Banque</option><option value="MOBILE_MONEY">Mobile money</option><option value="CARD">Carte</option></select></div></div>
<button type="submit">
if i.Direction=="PURCHASE" {
Enregistrer le paiement
} else {
Enregistrer l’encaissement
}
</button></form>
} else {
<p class="muted">Cette facture est entièrement réglée.</p>
}
}
 </div></section></div>
}
}

func paymentLabel(method string) string { return map[string]string{"CASH":"Espèces","BANK":"Banque","MOBILE_MONEY":"Mobile money","CARD":"Carte"}[method] }
func paymentAmount(i documents.Invoice,method string)string { for _,p:=range i.Payments {if p.Method==method{return p.Amount}};return "0" }
func statusClass(status string) string { if status=="NEEDS_REVIEW" { return "badge review" }; if status=="CONFIRMED" { return "badge confirmed" }; return "badge" }

templ Inventory(products []inventory.Product,orgName string) {
@Layout("Stock","inventory",orgName) {
@Heading("Stock","Quantités disponibles et valeur comptable des marchandises.") {
} <div class="panel table-scroll"><table><thead><tr><th>SKU</th><th>Produit</th><th>Unité</th><th class="amount">Disponible</th><th class="amount">Valeur USD</th></tr></thead><tbody>
for _,p:=range products {
<tr><td>{ p.SKU }</td><td>{ p.Name }</td><td>{ p.Unit }</td><td class="amount">{ p.Quantity.String() }</td><td class="amount">{ p.Value.StringFixed(2) }</td></tr>
}</tbody></table></div>
} }

templ Accounting(rows []accounting.JournalRow,orgName string) {
@Layout("Comptabilité","accounting",orgName) {
@Heading("Journal comptable","Écritures validées, équilibrées et non modifiables.") {
} <div class="accounting-visual"><img src="/static/accounting-ledger.webp" alt=""/><div><h2>Un journal lisible, opération par opération.</h2><p>Chaque ligne ci-dessous provient d’une écriture validée.</p></div></div><div class="panel table-scroll"><table><thead><tr><th>Date</th><th>Référence</th><th>Compte</th><th>Libellé</th><th class="amount">Débit USD</th><th class="amount">Crédit USD</th></tr></thead><tbody>
for _,r:=range rows {
<tr><td>{ r.Date }</td><td>{ r.Reference }</td><td>{ r.Code }</td><td>{ r.Name }</td><td class="amount">{ Money(r.Debit) }</td><td class="amount">{ Money(r.Credit) }</td></tr>
}</tbody></table></div>
} }

templ Cash(accounts []cash.Account,movements []cash.Movement,orgName string) {
@Layout("Trésorerie","cash",orgName) {
@Heading("Trésorerie","Soldes par moyen de paiement et historique des mouvements.") {
} <dl class="metrics">
for _,a:=range accounts {
<div class="metric"><dt>{ paymentLabel(a.Method) }</dt><dd>{ Money(a.Balance) } <small class="text-xs">USD</small></dd></div>
}</dl><div class="panel table-scroll"><table><thead><tr><th>Date</th><th>Moyen de paiement</th><th class="amount">Mouvement USD</th></tr></thead><tbody>
for _,m:=range movements {
<tr><td>{ m.Date }</td><td>{ paymentLabel(m.Method) }</td><td class="amount">{ Money(m.Amount) }</td></tr>
}</tbody></table></div>
} }

func activePage(active,path string) string { if active==path { return "page" };return "false" }
